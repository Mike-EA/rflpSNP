setwd("~/Documentos/pcr-RFLP")
library(rflpSNP)
gene_seq <- read_gene_fasta("MTHFR_completeseq.fa")
#-- 2. Ubicar el SNP con la secuencia de flanqueo ----
snp <- locate_snp(gene_seq, flank_seq = "GAAAAGCTGCGTGATGATGAAATCG")
#-- 3. Definir región de trabajo ----
region <- define_work_region(gene_seq, snp_pos = snp$snp_pos,
upstream = 160, downstream = 200)
# -- 4. Diseño de los primers ----
design <- design_primers(gene_seq, snp_pos = snp$snp_pos)
# -- 5. Exportar reporte ----
export_primers_txt(design, output_file = "primers_MTHFR.txt")
# -- 6. Simular PCR in silico
mp <- design$best_pair
pcr <- simulate_pcr(gene_seq,
fwd_primer = mp$forward_seq,
rev_primer = mp$reverse_seq)
amplicon <- pcr$amplicon
View(amplicon)
print(amplicon)
# -- 7. Ubicar el sitio de la enzima de restriccion
sitio <- find_restriction_site(pcr, enzyme_motif = "GANTC",
cut_offset = 1)
#-- 8. Graficar el amplicon y la secuencia
plot_amplicon_map(pcr, mp$forward_seq, mp$reverse_seq, sitio,
enzyme_name = "HinfI")
plot_sequence_map(pcr, sitio, enzyme_name = "HinfI")
mapa_amplicon <- plot_sequence_map(pcr, sitio, enzyme_name = "HinfI")
ggplot2::ggsave("mapa_amplicon.png", plot = mapa_amplicon, width = 8,
height = 4, dpi = 300)
<- Biostrings::DNAString("C")
gene_seq_alt <- gene_seq
Biostrings::subseq(gene_seq_alt,
start = snp$snp_pos, end = snp$snp_pos)
<- Biostrings::DNAString("C")
Biostrings::subseq(gene_seq_alt,
start = snp$snp_pos, end = snp$snp_pos) <- Biostrings::DNAString("C")
pcr_alt <- simulate_pcr(gene_seq_alt, mp$forward_seq, mp$reverse_seq)
sitio_alt <- find_restriction_site(pcr_alt, enzyme_motif = "GANTC", cut_offset = 1)
# -- 10. Simular el gel de agarosa ----
simulate_gel(amplicon_size = pcr$size,
fragment_sizes = c(108, 51),
genotype_labels = c("Homocigoto C/C,
Heterocigoto C/T",
"Homocigoto T/T"))
# -- 10. Simular el gel de agarosa ----
simulate_gel(amplicon_size = pcr$size,
fragment_sizes = c(108, 51),
genotype_labels = c("Homocigoto C/C",
"Heterocigoto C/T",
"Homocigoto T/T"))
# -- 11. Atajo - Todo el flujo en una sola llamada ----
resultado <- run_pcr_rflp_pipeline(
gene_seq, flank_seq = "GAAAAGCTGCGTGATGATGAAATCG",
enzyme_motif = "GANTC", cut_offset = 1
)
resultado$snp
resultado$design
resultado$pcr_result
resultado$restriction_result
library(rflpSNP)
library(Biostrings)
# 1. Load your target gene sequence (e.g., FTO gene)
gene_seq <- readDNAStringSet("/home/mike/Documentos/pcr-RFLP/FTO/fto.fa")[[1]]
# 2. Load the built-in restriction enzyme database (610 enzymes)
data("enzymes_db", package = "rflpSNP")
fto_seq <- read_gene_fasta("/home/mike/Documentos/pcr-RFLP/FTO/fto.fa")
snp <- locate_snp(gene_seq, flank_seq = "CATGCCAGTTGCCCACTGTGGCAAT")
# 3. Design PIRA-PCR mutagenic primers for a specific SNP
# (Targeting a T>A substitution at position 4520)
pira_results <- design_pira_primers(
gene_seq = fto_seq,
snp_pos = 78401,
allele_ref = "C",
allele_alt = "A",
enzymes_db = enzymes_db,
upstream = 200,
downstream = 200,
tm_min = 52,
tm_max = 62
)
